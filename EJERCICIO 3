////////////////////CLASE CLIENTE //////////////////////
import java.util.UUID;

public class Cliente {
    String nombre;
    String email;
    double porcentaje;
    public UUID id;

    public Cliente(String nombre, String email, double porcentaje, UUID id) {
        this.nombre = nombre;
        this.email = email;
        this.porcentaje = porcentaje;
        this.id = id;
    }

    public String getNombre() {
        return nombre;
    }

    public void setNombre(String nombre) {
        this.nombre = nombre;
    }

    public String getEmail() {
        return email;
    }

    public void setEmail(String email) {
        this.email = email;
    }

    public double getPorcentaje() {
        return porcentaje;
    }

    public void setPorcentaje(double porcentaje) {
        this.porcentaje = porcentaje;
    }

    public UUID getId() {
        return id;
    }

    public void setId(UUID id) {
        this.id = id;
    }

    @Override
    public String toString() {
        return "Cliente{" +
                "nombre='" + nombre + '\'' +
                ", email='" + email + '\'' +
                ", porcentaje=" + porcentaje +
                ", id=" + id +
                '}';
    }
}
/////////////CLASE FACTURA///////////////
import java.time.LocalDateTime;
import java.util.UUID;

public class Factura extends Cliente {

    double montoTotal;
    LocalDateTime now;


    public Factura(String nombre, String email, double porcentaje, UUID id, double montoTotal, LocalDateTime now) {
        super(nombre, email, porcentaje, id);
        this.montoTotal = montoTotal;
        this.now = now;
    }


    public double getMontoTotal() {
        return montoTotal;
    }

    public void setMontoTotal(double montoTotal) {
        this.montoTotal = montoTotal;
    }

    public LocalDateTime getNow() {
        return now;
    }

    public void setNow(LocalDateTime now) {
        this.now = now;
    }

    @Override
    public String toString() {
        return "Factura{" +
                "montoTotal=" + montoTotal +
                ", now=" + now +
                ", nombre='" + nombre + '\'' +
                ", email='" + email + '\'' +
                ", porcentaje=" + porcentaje +
                ", id=" + id +
                '}';
    }

    public void descuento (int porcentaje){
        double aux;
        aux = (porcentaje * this.montoTotal) / 100;

        this.montoTotal = this.montoTotal - aux;

    }
}
